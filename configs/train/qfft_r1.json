{
  "run_name": "qfft_r1_16k_b8",
  "format": "qfft",
  "init_model": "base",
  "data": "train/r1_qfft.jsonl",
  "max_length": 16384,
  "truncate": true,
  "num_train_epochs": 6,
  "learning_rate": 1e-05,
  "warmup_fraction": 0.1,
  "lr_scheduler_type": "cosine",
  "per_device_train_batch_size": 1,
  "gradient_accumulation_steps": 8,
  "weight_decay": 0.0001,
  "adam_beta1": 0.9,
  "adam_beta2": 0.999,
  "max_grad_norm": 1.0,
  "seed": 42,
  "save_steps": 125,
  "save_total_limit": 2,
  "deepspeed": "deepspeed_zero2.json",
  "liger": true,
  "attn_implementation": "sdpa"
}
