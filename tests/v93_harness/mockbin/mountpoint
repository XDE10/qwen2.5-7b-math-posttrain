#!/usr/bin/env python3
"""Fake mountpoint: a path counts as mounted when it is a symlink created by the fake `rclone mount`."""
import os
import sys

args = [a for a in sys.argv[1:] if not a.startswith('-')]
path = args[0] if args else ''
ok = os.path.islink(path) and os.path.isdir(path)
if '-q' not in sys.argv:
    print(f'{path} is {"a" if ok else "not a"} mountpoint')
sys.exit(0 if ok else 32)
