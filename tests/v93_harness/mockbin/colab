#!/usr/bin/env python3
"""Minimal stand-in for the google-colab-cli 0.7.5 commands launch.sh uses (test only).

Each session is a directory under $MOCK_ROOT/vms/<name>/ whose content/ plays the VM's /content; Drive is
shared across sessions at $MOCK_ROOT/drive. `exec` runs the code in a detached process (the "kernel"), so a
client disconnect (MOCK_DISCONNECT_AFTER seconds) leaves the job running, like the real CLI.
"""
import json
import os
import signal
import subprocess
import sys
import time
from pathlib import Path

ROOT = Path(os.environ['MOCK_ROOT'])
DRIVE = ROOT / 'drive'
args = sys.argv[1:]
cmd = args[0] if args else ''
VALUED = {'-s', '--session', '--gpu', '--timeout', '-f', '--file', '--tpu', '--env'}


def opt(*names, default=None):
    for name in names:
        if name in args:
            return args[args.index(name) + 1]
    return default


positional = []
i = 1
while i < len(args):
    if args[i] in VALUED:
        i += 2
        continue
    if not args[i].startswith('-'):
        positional.append(args[i])
    i += 1
session = opt('-s', '--session')


def vm(name):
    return ROOT / 'vms' / name


def state(name):
    p = vm(name) / 'state.json'
    return json.loads(p.read_text()) if p.exists() else {}


def save(name, value):
    (vm(name) / 'state.json').write_text(json.dumps(value))


def alive(name):
    return bool(name) and state(name).get('alive', False)


def calls(entry):
    with open(ROOT / 'calls.log', 'a') as f:
        f.write(entry + '\n')


calls(' '.join(args))
if cmd == 'usage':
    print('mock: 100 compute units left')
elif cmd == 'new':
    gpu = (opt('--gpu') or 'CPU').upper()
    if gpu in os.environ.get('MOCK_FAIL_GPUS', '').upper().split(','):
        print(f"[colab] Backend rejected accelerator '{gpu}'.", file=sys.stderr)
        sys.exit(1)
    if '--high-mem' in args and gpu in os.environ.get('MOCK_FAIL_HIGHMEM', '').upper().split(','):
        print(f"[colab] Backend rejected accelerator '{gpu}' (high-RAM shape).", file=sys.stderr)
        sys.exit(1)
    (vm(session) / 'content').mkdir(parents=True, exist_ok=True)
    save(session, {'alive': True, 'gpu': gpu, 'high_mem': '--high-mem' in args, 'pids': []})
    print(f"[colab] Creating session '{session}'... {gpu}")
elif cmd == 'drivemount':
    if not alive(session):
        sys.exit('session not found')
    if os.environ.get('MOCK_NO_DRIVE'):
        print('[colab] Error propagating: 403', file=sys.stderr)  # the real CLI still exits 0 here
        sys.exit(0)
    DRIVE.mkdir(parents=True, exist_ok=True)
    (vm(session) / 'content/drive').mkdir(parents=True, exist_ok=True)
    link = vm(session) / 'content/drive/MyDrive'
    if not link.exists():
        link.symlink_to(DRIVE)
    print('Mounted at /content/drive')
elif cmd in ('upload', 'download'):
    if not alive(session):
        sys.exit(1)
    a, b = positional
    if cmd == 'upload':
        dst = vm(session) / b.lstrip('/')
        dst.parent.mkdir(parents=True, exist_ok=True)
        dst.write_bytes(Path(a).read_bytes())
    else:
        src = vm(session) / a.lstrip('/')
        if not src.exists():
            sys.exit(1)
        Path(b).write_bytes(src.read_bytes())
elif cmd == 'exec':
    if not alive(session):
        print(f"[colab] Session '{session}' appears to be lost (404/401).", file=sys.stderr)
        sys.exit(1)
    path = opt('-f', '--file')
    code = Path(path).read_text() if path else sys.stdin.read()
    base = vm(session) / 'content'
    code = code.replace("'/content/", f"'{base}/").replace('"/content/', f'"{base}/')
    env = dict(os.environ, HOME=str(vm(session)), P1_LOCAL_ROOT=str(base / 'p1'), P1_DRIVE_ROOT=str(base / 'drive/MyDrive'),
               P1_RELEASE_GRACE_S=os.environ.get('MOCK_GRACE', '2'), MOCK_VM_DIR=str(vm(session)),
               PYTHONPATH=os.environ['MOCK_PYPATH'])
    n = len(list(vm(session).glob('kernel_*.out')))
    out_path = vm(session) / f'kernel_{n}.out'
    with open(out_path, 'w') as out:
        proc = subprocess.Popen([sys.executable, '-u', '-c', code], cwd=base, env=env, stdout=out,
                                stderr=subprocess.STDOUT, start_new_session=True)
    st = state(session)
    st['pids'] = st.get('pids', []) + [proc.pid]
    save(session, st)
    disconnect = float(os.environ.get('MOCK_DISCONNECT_AFTER', '0') or 0) if path else 0
    timeout = float(opt('--timeout') or 30)
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(143))
    started, pos = time.monotonic(), 0
    try:
        while True:
            with open(out_path) as f:
                f.seek(pos)
                chunk = f.read()
                pos = f.tell()
            if chunk:
                sys.stdout.write(chunk)
                sys.stdout.flush()
            if proc.poll() is not None:
                with open(out_path) as f:
                    f.seek(pos)
                    sys.stdout.write(f.read())
                break
            elapsed = time.monotonic() - started
            if disconnect and elapsed > disconnect:
                print('RuntimeError: Connection was lost.', file=sys.stderr)
                sys.exit(1)
            if elapsed > timeout:
                print('TimeoutError', file=sys.stderr)
                sys.exit(1)
            time.sleep(0.2)
    except KeyboardInterrupt:
        sys.exit(130)
elif cmd == 'stop':
    st = state(session)
    if not st.get('alive'):
        sys.exit(1)
    for pid in st.get('pids', []):
        try:
            os.killpg(pid, signal.SIGKILL)
        except (ProcessLookupError, PermissionError):
            pass
    st['alive'] = False
    st['stopped_by'] = 'colab stop'
    save(session, st)
    print(f'[colab] Session {session} stopped.')
else:
    sys.exit(f'mock colab: unsupported command {cmd}')
